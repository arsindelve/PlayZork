# PlayZork runtime configuration
PLAYZORK_GAME=zork
PLAYZORK_SESSION_ID=local-zork-session
PLAYZORK_LLM_PROVIDER=ollama

# Local Ollama service (used when PLAYZORK_LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Required only when PLAYZORK_LLM_PROVIDER=openai
OPENAI_API_KEY=

# Timeout / retry budgets (see GitHub issue #3 — these are coupled).
# A single LLM call's retry envelope (attempts x timeout + exponential backoff)
# must fit inside the turn budget, or retries 2..N are unreachable. A turn
# budget below the computed floor is raised to it automatically.
PLAYZORK_LLM_TIMEOUT_SECONDS=180
PLAYZORK_LLM_MAX_RETRIES=3
PLAYZORK_TURN_BUDGET_SECONDS=1200

# Provider selection: ollama (default) | openai | vllm
#
# vLLM is worth using on an NVIDIA GPU: it does real continuous batching,
# whereas Ollama on this Mac was measured serving concurrent requests at FLAT
# throughput (1/2/4/8 concurrency all ~0.26 req/s) — i.e. no parallelism at
# all. This project issues 5-10 concurrent calls per turn, so that difference
# is the whole ballgame. See STATUS.md, 2026-08-24.
#
#   vllm serve Qwen/Qwen2.5-14B-Instruct --max-model-len 8192
#
# PLAYZORK_LLM_PROVIDER=vllm
# PLAYZORK_VLLM_BASE_URL=http://localhost:8000/v1
# PLAYZORK_VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
